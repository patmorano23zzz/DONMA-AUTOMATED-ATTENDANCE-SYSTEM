Options -Indexes

# ── Error pages ────────────────────────────────────────────────────────────
ErrorDocument 404 /donma/error-pages/404.php
ErrorDocument 500 /donma/error-pages/500.php
ErrorDocument 403 /donma/error-pages/404.php

# ── Redirect .html → .php (legacy URLs) ───────────────────────────────────
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)\.html$ /$1.php [R=301,L]

# ── Default directory index ────────────────────────────────────────────────
DirectoryIndex index.php landing.php

# ── GZIP Compression (speeds up all text responses) ───────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/x-javascript image/svg+xml
</IfModule>

# ── Browser Caching for static assets ────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Images — 30 days
  ExpiresByType image/png             "access plus 30 days"
  ExpiresByType image/jpeg            "access plus 30 days"
  ExpiresByType image/gif             "access plus 30 days"
  ExpiresByType image/svg+xml         "access plus 30 days"
  ExpiresByType image/x-icon          "access plus 30 days"
  # CSS & JS — 7 days (versioned via ?v= so safe to cache)
  ExpiresByType text/css              "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript        "access plus 7 days"
  # Fonts — 30 days
  ExpiresByType font/woff             "access plus 30 days"
  ExpiresByType font/woff2            "access plus 30 days"
  ExpiresByType application/font-woff "access plus 30 days"
</IfModule>

# ── PHP output buffering hint ─────────────────────────────────────────────
<IfModule mod_headers.c>
  # Don't cache API responses
  <FilesMatch "^(check|record|export)\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
